{
  "title": "Caddy Metrics & Logs",
  "uid": "caddy-main",
  "schemaVersion": 36,
  "version": 1,
  "panels": [
    {
      "type": "stat",
      "title": "Active Connections",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "caddy_http_server_active_requests",
          "legendFormat": "active"
        }
      ],
      "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 }
    },
    {
      "type": "graph",
      "title": "Request Rate (req/s)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(caddy_http_requests_total[1m])",
          "legendFormat": "{{method}} {{host}}"
        }
      ],
      "gridPos": { "x": 6, "y": 0, "w": 18, "h": 6 }
    },
    {
      "type": "graph",
      "title": "Latency (95th percentile)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "histogram_quantile(0.95, sum(rate(caddy_http_request_duration_seconds_bucket[5m])) by (le))",
          "legendFormat": "p95"
        }
      ],
      "gridPos": { "x": 0, "y": 6, "w": 12, "h": 6 }
    },
    {
      "type": "graph",
      "title": "Error Rate (4xx/5xx)",
      "datasource": "Prometheus",
      "targets": [
        {
          "expr": "rate(caddy_http_requests_total{status=~\"4..\"}[5m])",
          "legendFormat": "4xx"
        },
        {
          "expr": "rate(caddy_http_requests_total{status=~\"5..\"}[5m])",
          "legendFormat": "5xx"
        }
      ],
      "gridPos": { "x": 12, "y": 6, "w": 12, "h": 6 }
    },
    {
      "type": "logs",
      "title": "Caddy Logs",
      "datasource": "Loki",
      "targets": [
        {
          "expr": "{job=\"caddy\"}"
        }
      ],
      "gridPos": { "x": 0, "y": 12, "w": 24, "h": 10 }
    }
  ]
}
